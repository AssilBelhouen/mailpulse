# Stable public HTTPS production origin. Never use a deployment URL or request Host.
# Local development may use http://127.0.0.1:3000.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret API key (or legacy service_role key).
# Configure directly in Vercel production; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
