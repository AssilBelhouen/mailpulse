{
  "name": "mailpulse",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:verifier": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "node scripts/with-local-env.mjs playwright test",
    "probe:new": "node scripts/new-probe.mjs",
    "probe:verify": "python3 scripts/verify-eml.py",
    "test:integration": "node scripts/with-local-env.mjs tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "sharp": "0.35.5",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
